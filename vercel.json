{
  "version": 2,
  "builds": [
    {
      "src": "api.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/calculate",
      "dest": "/api.js"
    },
    {
      "src": "/api/triangle",
      "dest": "/api.js?mode=triangle"
    },
    {
      "src": "/",
      "dest": "/api.js"
    }
  ]
}
